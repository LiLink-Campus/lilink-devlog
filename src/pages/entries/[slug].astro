---
/**
 * Bare HTML fragment for a single entry, consumed by the home reader.
 *
 * `partial` makes Astro emit just this component's markup — no <html>/<head> —
 * so the home page can fetch `/entries/<slug>` and drop it straight into the
 * reader. Each fragment is a static file built once per published post.
 */
import Entry from "../../components/Entry.astro";
import { getPublishedPosts, postSlug } from "../../lib/posts";

export const partial = true;

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post, i) => ({
    params: { slug: postSlug(post) },
    // Array is newest-first, so the newer neighbour sits at i-1, older at i+1.
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props;
---

<Entry post={post} newer={newer} older={older} />
