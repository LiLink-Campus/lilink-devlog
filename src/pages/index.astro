---
import Entry from "../components/Entry.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatEntryDate, toIsoDate } from "../lib/dates";
import { getPublishedPosts, groupByWeek, postPath, postSlug } from "../lib/posts";

const posts = await getPublishedPosts();
const weeks = groupByWeek(posts);

// The home page is the open book: a contents rail on the left, one entry's
// page on the right. Only the newest entry is server-rendered; the rest are
// fetched as fragments from /entries/<slug> on demand (see the script below),
// so the DOM never holds more than one article body no matter how many posts
// pile up. Standalone /posts/[slug] pages still exist for RSS, sharing, SEO
// and as the no-JS fallback the contents links point at.
const newest = posts[0];
const entryCount = posts.length;
const weekCount = weeks.length;

const description =
  "LiLink 开发日志：我们每周、甚至每天记录产品的迭代——遇到了什么问题，做了哪些改动，体验有了什么变化。";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "LiLink 开发日志",
  description,
  url: new URL("/", Astro.site).href,
  inLanguage: "zh-CN",
  publisher: {
    "@type": "Organization",
    name: "LiLink",
    logo: {
      "@type": "ImageObject",
      url: new URL("/og-default.png", Astro.site).href,
    },
  },
};
---

<BaseLayout title="LiLink devlog" description={description} jsonLd={jsonLd}>
  {
    weeks.length === 0 ? (
      <p class="empty container">还没有更新，很快就来。</p>
    ) : (
      <div class="book container">
        <nav class="toc" aria-label="目录" data-toc>
          <div class="toc-head">
            <h1>LiLink 开发日志</h1>
            <p class="toc-lede">持续记录每一次迭代</p>
            <p class="toc-stat">
              共 {entryCount} 篇 · 跨 {weekCount} 周
            </p>
          </div>
          <details class="toc-nav" open>
            <summary class="toc-toggle">
              <span>目录</span>
            </summary>
            <div class="toc-weeks">
              {weeks.map((week) => (
                <div class="toc-week">
                  <p class="toc-week-head">
                    <span>
                      {week.isoYear} · 第 {week.week} 周
                    </span>
                    <span class="range">{week.rangeLabel}</span>
                  </p>
                  <ul>
                    {week.posts.map((post) => (
                      <li>
                        <a
                          class:list={["toc-item", { featured: post.data.featured }]}
                          href={postPath(post)}
                          data-slug={postSlug(post)}
                          data-post-id={post.id}
                        >
                          <time datetime={toIsoDate(post.data.publishedAt)}>
                            {formatEntryDate(post.data.publishedAt)}
                          </time>
                          <span class="t">{post.data.title}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </details>
        </nav>

        <div class="reader" data-reader aria-live="polite" aria-atomic="true">
          <Entry post={newest} older={posts[1]} />
        </div>
      </div>
    )
  }
</BaseLayout>

<script>
  import { mountVideoFacades } from "../scripts/mount-video-facades";

  // The reader shows one entry at a time. The newest is server-rendered; every
  // other entry is fetched as a fragment from /entries/<slug> the first time
  // it's opened and cached, so the DOM never holds more than one article body.
  //
  // The contents + pager links carry both a real permalink href (so the page
  // degrades to a normal multi-page site without JS) and a data-slug we use to
  // swap entries in place. The active entry is mirrored into the URL hash so a
  // refresh keeps the book open on the same page.
  const readerEl = document.querySelector<HTMLElement>("[data-reader]");
  const tocEl = document.querySelector<HTMLElement>("[data-toc]");

  if (readerEl && tocEl) {
    const reader = readerEl;
    const toc = tocEl;

    const tocItems = Array.from(
      toc.querySelectorAll<HTMLAnchorElement>(".toc-item[data-slug]"),
    );

    // Slug order, newest-first — drives keyboard paging and neighbour lookup.
    const order = tocItems.map((a) => a.dataset.slug ?? "").filter(Boolean);

    // Legacy deep links used collection entry ids in the hash (#post.id).
    const idToSlug = new Map<string, string>();
    for (const a of tocItems) {
      const slug = a.dataset.slug;
      const id = a.dataset.postId;
      if (slug && id) idToSlug.set(id, slug);
    }

    const cache = new Map<string, string>();
    let current = reader.querySelector<HTMLElement>(".page")?.dataset.slug ?? order[0];
    let showToken = 0;
    const siteName = document.title;

    function postFallbackUrl(slug: string): string {
      return `/posts/${slug}`;
    }

    function syncDocumentTitle(): void {
      const title = reader.querySelector(".page-head h2")?.textContent?.trim();
      document.title = title ? `${title} · ${siteName}` : siteName;
    }

    function resolveSlug(hash: string): string | null {
      if (!hash) return order[0] ?? null;
      if (order.includes(hash)) return hash;
      const mapped = idToSlug.get(hash);
      if (mapped && order.includes(mapped)) return mapped;
      return null;
    }

    function setActive(slug: string): void {
      toc.querySelectorAll<HTMLElement>(".toc-item").forEach((a) => {
        const on = a.dataset.slug === slug;
        a.classList.toggle("is-active", on);
        if (on) a.scrollIntoView({ block: "nearest" });
      });
    }

    async function fetchFragment(slug: string): Promise<string | null> {
      const cached = cache.get(slug);
      if (cached !== undefined) return cached;
      try {
        const res = await fetch(`/entries/${slug}`);
        if (!res.ok) return null;
        const html = await res.text();
        if (!html.trim()) return null;
        cache.set(slug, html);
        return html;
      } catch {
        return null;
      }
    }

    async function show(rawSlug: string, push = true): Promise<void> {
      const slug = resolveSlug(rawSlug);
      if (!slug || !order.includes(slug)) return;

      const token = ++showToken;
      reader.setAttribute("aria-busy", "true");

      try {
        if (slug !== current) {
          const html = await fetchFragment(slug);
          if (token !== showToken) return;
          if (!html) {
            window.location.href = postFallbackUrl(slug);
            return;
          }

          reader.innerHTML = html;
          mountVideoFacades(reader);
          document.dispatchEvent(new Event("astro:page-load"));
          current = slug;
        }

        if (token !== showToken) return;

        setActive(current);
        syncDocumentTitle();
        if (push) {
          history.pushState({ slug: current }, "", `#${current}`);
        } else if (rawSlug !== current) {
          // Normalize legacy #post.id hashes to the canonical slug.
          history.replaceState({ slug: current }, "", `#${current}`);
        }
        reader.querySelector(".page")?.scrollIntoView({ block: "start" });
      } finally {
        if (token === showToken) reader.removeAttribute("aria-busy");
      }
    }

    mountVideoFacades(reader);

    // Intercept clicks on any in-book link carrying data-slug (contents + pagers).
    document.addEventListener("click", (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      if (event.button !== 0) return;
      const link = (event.target as HTMLElement).closest<HTMLAnchorElement>("a[data-slug]");
      const slug = link?.dataset.slug;
      if (!slug || !order.includes(slug)) return; // unknown → let the browser navigate
      event.preventDefault();
      void show(slug);
    });

    // ← / → page to the newer / older entry (array is newest-first).
    window.addEventListener("keydown", (event) => {
      if (event.metaKey || event.ctrlKey || event.altKey) return;
      const target = event.target as HTMLElement | null;
      if (
        target &&
        (target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName))
      )
        return;
      if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
      const i = order.indexOf(current);
      if (i === -1) return;
      const to = event.key === "ArrowLeft" ? order[i - 1] : order[i + 1];
      if (to) {
        event.preventDefault();
        void show(to);
      }
    });

    window.addEventListener("popstate", () => {
      const hash = decodeURIComponent(window.location.hash.slice(1));
      const slug = resolveSlug(hash) ?? order[0];
      if (slug) void show(slug, false);
    });

    // The <details> ships `open`; collapse it only on narrow screens.
    const details = document.querySelector<HTMLDetailsElement>(".toc-nav");
    const mql = window.matchMedia("(max-width: 820px)");
    const syncCollapse = (e: MediaQueryList | MediaQueryListEvent) => {
      if (details) details.open = !e.matches;
    };
    if (details) {
      syncCollapse(mql);
      mql.addEventListener("change", syncCollapse);
    }

    // Deep link: open the entry named in the URL hash on load.
    const initialHash = decodeURIComponent(window.location.hash.slice(1));
    const initial = initialHash ? resolveSlug(initialHash) : null;
    if (initial && initial !== current) {
      void show(initial, false);
    } else {
      setActive(current);
      syncDocumentTitle();
    }
  }
</script>

<style>
  .empty {
    padding-block: var(--space-8);
    color: var(--color-text-muted);
  }

  .book {
    display: grid;
    grid-template-columns: 16.5rem minmax(0, 1fr);
    gap: var(--space-8);
    align-items: start;
    padding-block: var(--space-6) var(--space-8);
  }

  /* Left rail — the contents / spine of the book */
  .toc {
    position: sticky;
    top: 4.75rem;
    max-height: calc(100dvh - 5.75rem);
    overflow: auto;
    padding-right: var(--space-2);
  }

  .toc-head {
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .toc-head h1 {
    margin: 0;
    font-size: 1.25rem;
    color: var(--color-brand-ink);
  }

  .toc-head .toc-lede {
    margin: var(--space-1) 0 0;
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }

  .toc-stat {
    margin: var(--space-3) 0 0;
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .toc-nav {
    margin: 0;
  }

  /* The toggle only appears on narrow screens (see media query). */
  .toc-toggle {
    display: none;
  }

  .toc-week + .toc-week {
    margin-top: var(--space-5);
  }

  .toc-week-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    margin: 0 0 var(--space-2);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .toc-week-head .range {
    font-weight: 400;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .toc ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .toc-item {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    padding: var(--space-2);
    border-radius: var(--radius-xs);
    border-left: 2px solid transparent;
    transition:
      background 0.15s ease,
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .toc-item time {
    flex-shrink: 0;
    font-size: 0.74rem;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .toc-item .t {
    font-size: 0.9rem;
    line-height: 1.4;
    color: var(--color-text-secondary);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  .toc-item:hover {
    background: var(--color-surface-muted);
  }

  .toc-item:hover .t {
    color: var(--color-brand);
  }

  .toc-item.featured .t::after {
    content: "★";
    margin-left: 0.3rem;
    font-size: 0.7em;
    vertical-align: 0.2em;
    color: var(--color-gold);
  }

  .toc-item.is-active {
    background: var(--color-brand-tint);
    border-left-color: var(--color-brand);
  }

  .toc-item.is-active .t {
    color: var(--color-brand-ink);
    font-weight: 600;
  }

  .toc-item.is-active time {
    color: var(--color-brand);
  }

  /* Right page — a single entry, swapped in place by the reader script.
     The entry's own styling lives in Entry.astro (shared with the fragments). */
  .reader {
    min-width: 0;
  }

  /* Narrow screens: the contents collapse above the page */
  @media (max-width: 820px) {
    .book {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .toc {
      position: static;
      max-height: none;
      overflow: visible;
      padding-right: 0;
    }

    .toc-toggle {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      margin-top: var(--space-4);
      padding: var(--space-2) var(--space-4);
      border: 1px solid var(--color-border-strong);
      border-radius: var(--radius-pill);
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--color-text-secondary);
      cursor: pointer;
      list-style: none;
      width: max-content;
    }

    .toc-toggle::-webkit-details-marker {
      display: none;
    }

    .toc-toggle::after {
      content: "▾";
      font-size: 0.8em;
      transition: transform 0.15s ease;
    }

    .toc-nav[open] .toc-toggle::after {
      transform: rotate(180deg);
    }

    .toc-weeks {
      margin-top: var(--space-4);
    }
  }
</style>
