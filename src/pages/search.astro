---
/**
 * Dedicated full-page site search.
 *
 * A big centred search box with the results listed inline below it. The inline
 * script lazy-fetches /search-index.json (published posts only) and runs the
 * same dependency-free weighted fuzzy match used elsewhere
 * (title > tags > authors > summary > body).
 *
 * The query is synced to the URL as ?q=…&page=…: on load the page reads it,
 * fills the input and renders; typing updates the URL via history.replaceState
 * so the search is shareable and survives a refresh. Results paginate at 24
 * per page.
 */
import BaseLayout from "../layouts/BaseLayout.astro";

const description = "在 LiLink 开发日志里搜索全部更新：按标题、标签、作者与正文检索。";
---

<BaseLayout title="搜索" description={description}>
  <div class="search-page container">
    <header class="page-head">
      <a class="back" href="/">← 全部更新</a>
      <h1>搜索</h1>
      <p class="page-summary">输入关键词，从这里检索每一条更新。</p>
    </header>

    <form class="search-box" role="search" data-search-form>
      <svg
        class="icon search-box-icon"
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <label class="visually-hidden" for="search-input">搜索文章</label>
      <input
        id="search-input"
        type="search"
        class="search-input"
        placeholder="搜索更新、标题、标签…"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        data-search-input
      />
    </form>

    <div class="search-results" data-search-results aria-live="polite">
      <p class="search-hint" data-search-hint hidden></p>
      <ul class="search-list" data-search-list hidden></ul>
      <nav class="search-pagination" data-search-pagination hidden aria-label="搜索结果分页"></nav>
    </div>
  </div>
</BaseLayout>

<script>
  type SearchItem = {
    id: string;
    url: string;
    title: string;
    summary: string;
    date: string;
    tags: string[];
    authors: string[];
    body: string;
  };

  const formEl = document.querySelector<HTMLFormElement>("[data-search-form]");
  const inputEl = document.querySelector<HTMLInputElement>("[data-search-input]");
  const listEl = document.querySelector<HTMLUListElement>("[data-search-list]");
  const hintEl = document.querySelector<HTMLParagraphElement>("[data-search-hint]");
  const paginationEl = document.querySelector<HTMLElement>("[data-search-pagination]");

  if (formEl && inputEl && listEl && hintEl && paginationEl) {
    const form = formEl;
    const input = inputEl;
    const list = listEl;
    const hint = hintEl;
    const pagination = paginationEl;

    const PAGE_SIZE = 24;
    const QUERY_PARAM = "q";
    const PAGE_PARAM = "page";
    let index: SearchItem[] | null = null;
    let loading: Promise<SearchItem[]> | null = null;

    // --- data ---------------------------------------------------------------
    async function loadIndex(): Promise<SearchItem[]> {
      if (index) return index;
      if (!loading) {
        loading = fetch("/search-index.json")
          .then((res) => (res.ok ? res.json() : []))
          .then((data: SearchItem[]) => {
            index = Array.isArray(data) ? data : [];
            return index;
          })
          .catch(() => {
            index = [];
            return index;
          });
      }
      return loading;
    }

    // --- scoring ------------------------------------------------------------
    // Hand-rolled, dependency-free. Per query token we score each field; the
    // strongest field hit wins for that token, multiplied by the field weight.
    // A result is kept only if EVERY token matches somewhere (AND semantics).

    /** Substring (best, position-aware) or in-order subsequence (fuzzy). */
    function fieldScore(haystack: string, needle: string): number {
      if (!needle) return 0;
      const hay = haystack.toLowerCase();
      const idx = hay.indexOf(needle);
      if (idx === 0) return 1; // prefix match
      if (idx > 0) return 0.8; // substring match
      // Subsequence: characters appear in order but not contiguous.
      let h = 0;
      for (let n = 0; n < needle.length; n += 1) {
        h = hay.indexOf(needle[n], h);
        if (h === -1) return 0;
        h += 1;
      }
      return 0.4;
    }

    function scoreItem(item: SearchItem, tokens: string[]): number {
      const fields: Array<[string, number]> = [
        [item.title, 6],
        [item.tags.join(" "), 4],
        [item.authors.join(" "), 3],
        [item.summary, 2],
        [item.body, 1],
      ];
      let total = 0;
      for (const token of tokens) {
        let best = 0;
        for (const [text, weight] of fields) {
          const s = fieldScore(text, token) * weight;
          if (s > best) best = s;
        }
        if (best === 0) return 0; // this token matched nothing -> drop result
        total += best;
      }
      return total;
    }

    function queryTokens(query: string): string[] {
      return query
        .toLowerCase()
        .split(/\s+/)
        .map((t) => t.trim())
        .filter(Boolean);
    }

    function search(query: string): SearchItem[] {
      const tokens = queryTokens(query);
      if (tokens.length === 0 || !index) return [];
      return index
        .map((item) => ({ item, score: scoreItem(item, tokens) }))
        .filter((r) => r.score > 0)
        .sort((a, b) => {
          if (b.score !== a.score) return b.score - a.score;
          // Tiebreak: newer first (ISO dates sort lexicographically).
          return a.item.date < b.item.date ? 1 : -1;
        })
        .map((r) => r.item);
    }

    // --- rendering ----------------------------------------------------------
    function escapeHtml(value: string): string {
      return value
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
    }

    function escapeRegExp(value: string): string {
      return value.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
    }

    // Escape `text`, wrapping case-insensitive matches of any query token in
    // <mark>. Operates on the raw text so escaping and marking never collide.
    function highlight(text: string, tokens: string[]): string {
      if (!text) return "";
      const terms = tokens.filter(Boolean);
      if (terms.length === 0) return escapeHtml(text);
      const re = new RegExp("(" + terms.map(escapeRegExp).join("|") + ")", "gi");
      let out = "";
      let last = 0;
      let m: RegExpExecArray | null;
      while ((m = re.exec(text)) !== null) {
        out += escapeHtml(text.slice(last, m.index));
        out += "<mark>" + escapeHtml(m[0]) + "</mark>";
        last = m.index + m[0].length;
        if (m.index === re.lastIndex) re.lastIndex++; // guard zero-length matches
      }
      out += escapeHtml(text.slice(last));
      return out;
    }

    // A short context snippet around the first body hit (term highlighted);
    // falls back to the summary when the match was only in the title/tags.
    function makeSnippet(item: SearchItem, tokens: string[]): string {
      const body = item.body || "";
      const lower = body.toLowerCase();
      let hit = -1;
      for (const t of tokens) {
        const i = lower.indexOf(t);
        if (i !== -1 && (hit === -1 || i < hit)) hit = i;
      }
      if (hit === -1) return highlight(item.summary || "", tokens);
      const RADIUS = 56;
      const start = Math.max(0, hit - RADIUS);
      const end = Math.min(body.length, hit + RADIUS * 2);
      const slice = body.slice(start, end).trim();
      const prefix = start > 0 ? "… " : "";
      const suffix = end < body.length ? " …" : "";
      return prefix + highlight(slice, tokens) + suffix;
    }

    function renderItem(item: SearchItem, tokens: string[]): string {
      const titleHtml = highlight(item.title, tokens);
      const snippetHtml = makeSnippet(item, tokens);
      const meta = [item.date, ...item.tags].map(escapeHtml).join(" · ");
      return `
        <li class="search-item">
          <a href="${escapeHtml(item.url)}">
            <span class="search-item-title">${titleHtml}</span>
            ${snippetHtml ? `<span class="search-item-snippet">${snippetHtml}</span>` : ""}
            <span class="search-item-meta">${meta}</span>
          </a>
        </li>`;
    }

    function renderPagination(total: number, page: number, totalPages: number): void {
      if (totalPages <= 1) {
        pagination.hidden = true;
        pagination.innerHTML = "";
        return;
      }

      const prevPage = page > 1 ? page - 1 : null;
      const nextPage = page < totalPages ? page + 1 : null;
      pagination.hidden = false;
      pagination.innerHTML = `
        <p class="search-page-status">共 ${total} 条 · 第 ${page} / ${totalPages} 页</p>
        <div class="search-page-nav">
          <button
            type="button"
            class="page-btn"
            data-page="${prevPage ?? page}"
            ${prevPage ? "" : "disabled"}
          >上一页</button>
          <button
            type="button"
            class="page-btn"
            data-page="${nextPage ?? page}"
            ${nextPage ? "" : "disabled"}
          >下一页</button>
        </div>`;
    }

    function render(query: string, page = 1): void {
      pagination.hidden = true;
      pagination.innerHTML = "";

      if (!query.trim()) {
        list.hidden = true;
        list.innerHTML = "";
        hint.hidden = true;
        return;
      }

      const all = search(query);
      if (all.length === 0) {
        list.hidden = true;
        list.innerHTML = "";
        hint.hidden = false;
        hint.textContent = `没有找到与「${query.trim()}」相关的更新。`;
        return;
      }

      const totalPages = Math.ceil(all.length / PAGE_SIZE);
      const safePage = Math.min(Math.max(1, page), totalPages);
      if (safePage !== page) {
        writeQueryToUrl(query, safePage);
      }

      const start = (safePage - 1) * PAGE_SIZE;
      const results = all.slice(start, start + PAGE_SIZE);
      const tokens = queryTokens(query);

      hint.hidden = true;
      list.hidden = false;
      list.innerHTML = results.map((item) => renderItem(item, tokens)).join("");
      renderPagination(all.length, safePage, totalPages);
    }

    // --- url sync -----------------------------------------------------------
    function readQueryFromUrl(): string {
      return new URLSearchParams(window.location.search).get(QUERY_PARAM) ?? "";
    }

    function readPageFromUrl(): number {
      const raw = new URLSearchParams(window.location.search).get(PAGE_PARAM);
      const page = raw ? Number.parseInt(raw, 10) : 1;
      return Number.isFinite(page) && page >= 1 ? page : 1;
    }

    // Reflect the current query (and page when > 1) into the URL without
    // growing history; drop params when the box is empty so /search stays clean.
    function writeQueryToUrl(query: string, page = 1): void {
      const url = new URL(window.location.href);
      if (query.trim()) {
        url.searchParams.set(QUERY_PARAM, query);
        if (page > 1) {
          url.searchParams.set(PAGE_PARAM, String(page));
        } else {
          url.searchParams.delete(PAGE_PARAM);
        }
      } else {
        url.searchParams.delete(QUERY_PARAM);
        url.searchParams.delete(PAGE_PARAM);
      }
      window.history.replaceState(null, "", url);
    }

    // --- wiring -------------------------------------------------------------
    const initialQuery = readQueryFromUrl();
    const initialPage = readPageFromUrl();
    if (initialQuery) input.value = initialQuery;
    render(input.value, initialPage);

    void loadIndex().then(() => render(input.value, readPageFromUrl()));

    input.addEventListener("input", () => {
      writeQueryToUrl(input.value, 1);
      render(input.value, 1);
    });

    pagination.addEventListener("click", (event) => {
      const target = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-page]");
      if (!target || target.disabled) return;
      const page = Number.parseInt(target.dataset.page ?? "1", 10);
      if (!Number.isFinite(page) || page < 1) return;
      writeQueryToUrl(input.value, page);
      render(input.value, page);
      list.scrollIntoView({ behavior: "smooth", block: "start" });
    });

    window.addEventListener("popstate", () => {
      input.value = readQueryFromUrl();
      render(input.value, readPageFromUrl());
    });

    // Enter navigates to the first result, matching typical search UX.
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const first = list.querySelector<HTMLAnchorElement>("a");
      if (first) window.location.href = first.href;
    });

    requestAnimationFrame(() => input.focus());
  }
</script>

<style>
  .search-page {
    width: min(100% - 2.4rem, var(--measure));
    padding-block: var(--space-5) var(--space-8);
  }

  .back {
    display: inline-block;
    margin-bottom: var(--space-3);
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    transition: color 0.15s ease;
  }

  .back:hover {
    color: var(--color-brand);
  }

  .page-head h1 {
    margin: 0 0 var(--space-2);
    font-size: clamp(1.35rem, 2.5vw, 1.6rem);
    line-height: 1.25;
    text-wrap: balance;
  }

  .page-head .page-summary {
    margin: var(--space-1) 0 0;
    max-width: 32em;
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-style: italic;
    font-weight: 400;
    line-height: 1.75;
    letter-spacing: 0.015em;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: var(--space-3);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-surface-tinted);
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .search-box:focus-within {
    border-color: var(--color-brand);
    box-shadow: 0 0 0 3px var(--color-brand-tint);
  }

  .search-box-icon {
    flex-shrink: 0;
    color: var(--color-text-muted);
  }

  .search-input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--color-text);
    font: inherit;
    font-size: 1rem;
    line-height: 1.35;
  }

  .search-input::placeholder {
    color: var(--color-text-muted);
  }

  .search-input:focus {
    outline: none;
  }

  /* Hide the native search clear affordance for a cleaner book feel. */
  .search-input::-webkit-search-decoration,
  .search-input::-webkit-search-cancel-button {
    appearance: none;
  }

  .search-results {
    margin-top: var(--space-5);
  }

  .search-hint {
    margin: 0;
    padding: var(--space-4) var(--space-2);
    color: var(--color-text-muted);
    font-size: 0.95rem;
    text-wrap: pretty;
  }

  .search-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .search-list[hidden] {
    display: none;
  }

  .search-pagination[hidden] {
    display: none;
  }

  .search-results :global(.search-page-status) {
    margin: var(--space-4) var(--space-2) var(--space-3);
    color: var(--color-text-muted);
    font-size: 0.88rem;
    font-variant-numeric: tabular-nums;
  }

  .search-results :global(.search-page-nav) {
    display: flex;
    justify-content: center;
    gap: var(--space-3);
    padding: 0 var(--space-2) var(--space-2);
  }

  .search-results :global(.page-btn) {
    padding: 0.45rem 1rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-text-secondary);
    font: inherit;
    font-size: 0.9rem;
    cursor: pointer;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .search-results :global(.page-btn:hover:not(:disabled)) {
    color: var(--color-brand);
    border-color: var(--color-brand);
  }

  .search-results :global(.page-btn:disabled) {
    opacity: 0.45;
    cursor: not-allowed;
  }

  /*
   * Result items are injected via innerHTML, so they never receive Astro's
   * scope attribute — these selectors must be :global() to take effect.
   */
  .search-results :global(.search-item a) {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: var(--space-4) var(--space-2);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
    transition: background 0.12s ease;
  }

  .search-results :global(.search-item a:hover),
  .search-results :global(.search-item a:focus-visible) {
    background: var(--color-surface-tinted);
    outline: none;
  }

  .search-results :global(.search-item-title) {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-brand-ink);
  }

  .search-results :global(.search-item a:hover .search-item-title),
  .search-results :global(.search-item a:focus-visible .search-item-title) {
    color: var(--color-brand);
  }

  .search-results :global(.search-item-snippet) {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    line-height: 1.6;
    text-wrap: pretty;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .search-results :global(.search-item-meta) {
    margin-top: 0.1rem;
    color: var(--color-text-muted);
    font-size: 0.78rem;
    letter-spacing: 0.01em;
    font-variant-numeric: tabular-nums;
  }

  /* Matched query terms — warm wine tint, never the browser's default yellow. */
  .search-results :global(.search-item mark) {
    background: var(--color-brand-soft);
    color: var(--color-brand-ink);
    border-radius: 3px;
    padding: 0 0.14em;
    font-weight: 600;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    overflow: hidden;
    white-space: nowrap;
  }
</style>
