---
import BaseLayout from "../layouts/BaseLayout.astro";

const description = "搜索 LiLink 开发日志的全部更新。";
---

<BaseLayout title="搜索" description={description}>
  <div class="search-page container">
    <header class="search-head">
      <h1>搜索</h1>
      <p class="lede">在标题、摘要、标签、作者与正文里找你想看的更新。</p>
    </header>

    <form class="search-form" role="search" autocomplete="off">
      <label class="visually-hidden" for="search-input">搜索关键词</label>
      <input
        id="search-input"
        type="search"
        name="q"
        placeholder="搜索标题、摘要、标签、作者、正文…"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
      />
    </form>

    <p class="status" id="search-status" aria-live="polite"></p>

    <noscript>
      <p class="hint">搜索功能需要启用 JavaScript 才能使用。</p>
    </noscript>

    <div id="search-results" class="results" aria-live="polite"></div>
  </div>
</BaseLayout>

<script>
  import { fuzzySearch, type SearchDoc } from "../lib/search";

  const input = document.getElementById("search-input") as HTMLInputElement | null;
  const statusEl = document.getElementById("search-status");
  const resultsEl = document.getElementById("search-results");

  if (input && statusEl && resultsEl) {
    let docs: SearchDoc[] | null = null;
    let loadPromise: Promise<SearchDoc[]> | null = null;

    function loadIndex(): Promise<SearchDoc[]> {
      if (docs) return Promise.resolve(docs);
      if (loadPromise) return loadPromise;
      loadPromise = fetch("/search-index.json")
        .then((r) => {
          if (!r.ok) throw new Error(`HTTP ${r.status}`);
          return r.json();
        })
        .then((data: SearchDoc[]) => {
          docs = data;
          return data;
        });
      return loadPromise;
    }

    // Escape user-supplied text before inserting into innerHTML.
    function escapeHtml(s: string): string {
      return s
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
    }

    // Highlight the first occurrence run of any query token within `text`.
    function highlight(text: string, query: string): string {
      const safe = escapeHtml(text);
      const tokens = query
        .trim()
        .toLowerCase()
        .split(/\s+/)
        .filter(Boolean)
        .map((t) => t.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"));
      if (tokens.length === 0) return safe;
      try {
        const re = new RegExp(`(${tokens.join("|")})`, "gi");
        return safe.replace(re, "<mark>$1</mark>");
      } catch {
        return safe;
      }
    }

    // Build a short body excerpt centered on the first matched token.
    function excerpt(doc: SearchDoc, query: string): string {
      const tokens = query.trim().toLowerCase().split(/\s+/).filter(Boolean);
      const hay = doc.text.toLowerCase();
      let idx = -1;
      for (const t of tokens) {
        const at = hay.indexOf(t);
        if (at !== -1 && (idx === -1 || at < idx)) idx = at;
      }
      const base = doc.summary || doc.text;
      if (idx === -1) {
        return base.slice(0, 140);
      }
      const start = Math.max(0, idx - 40);
      const slice = doc.text.slice(start, start + 160);
      return (start > 0 ? "…" : "") + slice + (start + 160 < doc.text.length ? "…" : "");
    }

    function render(query: string, results: ReturnType<typeof fuzzySearch>) {
      if (!query) {
        statusEl!.textContent = "";
        resultsEl!.innerHTML = "";
        return;
      }
      if (results.length === 0) {
        statusEl!.textContent = "";
        resultsEl!.innerHTML = '<p class="empty">没有找到相关更新。</p>';
        return;
      }
      statusEl!.textContent = `找到 ${results.length} 篇相关更新`;
      const html = results
        .map(({ doc }) => {
          const tags = doc.tags
            .map((t) => `<span class="chip">${escapeHtml(t)}</span>`)
            .join("");
          return `
            <a class="result" href="${escapeHtml(doc.url)}">
              <time datetime="${escapeHtml(doc.date)}">${escapeHtml(doc.dateLabel)}</time>
              <span class="result-title">${highlight(doc.title, query)}</span>
              <span class="result-snippet">${highlight(excerpt(doc, query), query)}</span>
              ${tags ? `<span class="result-tags">${tags}</span>` : ""}
            </a>`;
        })
        .join("");
      resultsEl!.innerHTML = html;
    }

    async function run(query: string, replaceUrl = true) {
      if (replaceUrl) {
        const url = new URL(location.href);
        if (query) url.searchParams.set("q", query);
        else url.searchParams.delete("q");
        history.replaceState(null, "", url.pathname + url.search);
      }
      if (!query.trim()) {
        render("", []);
        return;
      }
      try {
        const loaded = await loadIndex();
        render(query, fuzzySearch(query, loaded));
      } catch {
        statusEl!.textContent = "搜索索引加载失败，请稍后重试。";
      }
    }

    let timer: ReturnType<typeof setTimeout> | undefined;
    input.addEventListener("input", () => {
      clearTimeout(timer);
      timer = setTimeout(() => run(input.value), 120);
    });

    // ?q= deep-linking: prefill, focus, and run on load.
    const initial = new URLSearchParams(location.search).get("q") ?? "";
    if (initial) {
      input.value = initial;
      run(initial, false);
    }
    input.focus();
  }
</script>

<style>
  .search-page {
    padding-block: var(--space-7) var(--space-8);
  }

  .search-head {
    margin-bottom: var(--space-5);
  }

  .search-head h1 {
    margin: 0;
    font-size: clamp(1.6rem, 3vw, 2rem);
    color: var(--color-brand-ink);
  }

  .search-head .lede {
    margin: var(--space-2) 0 0;
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--color-text-secondary);
  }

  .search-form {
    margin-bottom: var(--space-4);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  #search-input {
    width: 100%;
    padding: var(--space-3) var(--space-4);
    font: inherit;
    font-size: 1.05rem;
    color: var(--color-text);
    background: var(--color-surface);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  #search-input:focus {
    outline: none;
    border-color: var(--color-brand);
    box-shadow: 0 0 0 3px var(--color-focus);
  }

  .status {
    margin: 0 0 var(--space-4);
    min-height: 1.2em;
    font-size: 0.82rem;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .hint,
  .empty {
    color: var(--color-text-muted);
  }

  .results {
    display: flex;
    flex-direction: column;
  }

  .result + .result {
    border-top: 1px solid var(--color-border);
  }

  .result {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: var(--space-1) var(--space-4);
    padding: var(--space-4) var(--space-2);
    border-radius: var(--radius-xs);
    transition: background 0.15s ease;
  }

  .result:hover {
    background: var(--color-surface-tinted);
  }

  .result time {
    grid-row: 1 / span 3;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .result-title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--color-text);
    transition: color 0.15s ease;
  }

  .result:hover .result-title {
    color: var(--color-brand);
  }

  .result-snippet {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--color-text-secondary);
  }

  .result-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-1);
  }

  .chip {
    padding: 0.15rem 0.55rem;
    font-size: 0.72rem;
    color: var(--color-brand-ink);
    background: var(--color-brand-tint);
    border-radius: var(--radius-pill);
  }

  :global(mark) {
    background: var(--color-brand-soft);
    color: var(--color-brand-ink);
    border-radius: 0.2rem;
    padding: 0 0.1rem;
  }

  @media (max-width: 560px) {
    .result {
      grid-template-columns: 1fr;
    }

    .result time {
      grid-row: auto;
    }
  }
</style>
