---
/**
 * AuthorByline — 紧凑、低调的作者署名，用于文章 meta 行。
 * resolveAuthors 解析 id，未知 id 静默丢弃；无可解析作者则不渲染。
 * 若作者带 links，名字会包成一个克制的 <a>（指向第一条链接）。
 */
import { resolveAuthors, type Author } from "../lib/authors";

interface Props {
  ids: string[];
}

const { ids } = Astro.props;
const resolved: Author[] = resolveAuthors(ids);

/** 取作者的首条外链作为名字的可点击目标（若有）。 */
function primaryHref(author: Author): string | undefined {
  return author.links?.[0]?.href;
}
---

{
  resolved.length > 0 ? (
    <span class="byline">
      {resolved.map((author, i) => {
        const href = primaryHref(author);
        return (
          <>
            {i > 0 ? <span class="sep" aria-hidden="true">、</span> : null}
            {href ? (
              <a class="name" href={href} title={author.role ?? author.name}>
                {author.name}
              </a>
            ) : (
              <span class="name" title={author.role ?? author.name}>
                {author.name}
              </span>
            )}
          </>
        );
      })}
    </span>
  ) : null
}

<style>
  .byline {
    display: inline;
    color: var(--color-text-muted);
  }

  .name {
    color: inherit;
  }

  /* 名字若可点击，仅在 hover 时显出酒红，平时保持低调。 */
  a.name {
    transition: color 0.15s ease;
  }

  a.name:hover {
    color: var(--color-brand);
  }

  .sep {
    color: var(--color-border-strong);
    margin-inline: 0.1em;
  }
</style>
