---
/**
 * One "page" of the home book: an article's full body with its header, cover
 * and prev/next pager.
 *
 * Used in two places that must stay byte-for-byte identical so the home reader
 * can swap entries in place:
 *   · the home page server-renders the newest entry up front, and
 *   · /entries/[slug] (an Astro partial) renders any entry as a bare fragment
 *     that the home reader fetches and injects on demand.
 *
 * Because both go through this single component, the scoped styles below ship
 * with the home page (it renders the newest entry), and the injected fragments
 * reuse the very same scope hash — so they're styled without any extra CSS.
 */
import { Image } from "astro:assets";
import { render } from "astro:content";
import AuthorByline from "./AuthorByline.astro";
import TagList from "./TagList.astro";
import { mdxComponents } from "./mdx";
import { formatPublishedDate, formatWeekLabel, toIsoDate } from "../lib/dates";
import { postPath, postSlug, type Post } from "../lib/posts";

interface Props {
  post: Post;
  /** Newer neighbour (left pager). Omit at the newest entry. */
  newer?: Post;
  /** Older neighbour (right pager). Omit at the oldest entry. */
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const { title, summary, publishedAt, authors, tags, cover, coverAlt } = post.data;
---

<article class="page" id={post.id} data-slug={postSlug(post)}>
  <header class="page-head">
    <p class="page-meta">
      <time datetime={toIsoDate(publishedAt)}>{formatPublishedDate(publishedAt)}</time>
      <span class="dot" aria-hidden="true">·</span>
      <span class="week">{formatWeekLabel(publishedAt)}</span>
      <span class="dot" aria-hidden="true">·</span>
      <span class="by"><AuthorByline ids={authors} /></span>
    </p>
    <h2>{title}</h2>
    <p class="page-summary">{summary}</p>
    <div class="page-tags">
      <TagList ids={tags} size="sm" />
    </div>
  </header>
  {
    cover ? (
      <Image class="page-cover" src={cover} alt={coverAlt ?? title} widths={[480, 960]} />
    ) : null
  }
  <div class="prose">
    <Content components={mdxComponents} />
  </div>
  <footer class="page-foot">
    <div class="pager">
      {
        newer ? (
          <a class="pager-link prev" href={postPath(newer)} data-slug={postSlug(newer)}>
            <span class="pager-dir">← 更新的一条</span>
            <span class="pager-title">{newer.data.title}</span>
          </a>
        ) : (
          <span class="pager-link is-empty" aria-hidden="true" />
        )
      }
      {
        older ? (
          <a class="pager-link next" href={postPath(older)} data-slug={postSlug(older)}>
            <span class="pager-dir">更早的一条 →</span>
            <span class="pager-title">{older.data.title}</span>
          </a>
        ) : (
          <span class="pager-link is-empty" aria-hidden="true" />
        )
      }
    </div>
    <a class="permalink" href={postPath(post)}>永久链接 ↗</a>
  </footer>
</article>

<style>
  .page {
    max-width: var(--measure);
    scroll-margin-top: 4.75rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .page {
      animation: turn 0.24s ease;
    }
  }

  @keyframes turn {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .page-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
    margin: 0;
    font-size: 0.82rem;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .page-meta .dot {
    color: var(--color-border-strong);
  }

  .page-head h2 {
    margin: var(--space-3) 0 var(--space-3);
    font-size: clamp(1.75rem, 3.5vw, 2.25rem);
    text-wrap: balance;
  }

  /* Lede under the headline — italic, smaller, visually subordinate to the title. */
  .page-head .page-summary {
    margin: var(--space-2) 0 0;
    max-width: 32em;
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-style: italic;
    font-weight: 400;
    line-height: 1.75;
    letter-spacing: 0.015em;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  /* Subtle tag chips under the summary; collapses when the entry has no tags. */
  .page-tags {
    margin-top: var(--space-3);
  }

  .page-tags:empty {
    margin-top: 0;
  }

  .page-cover {
    width: 100%;
    height: auto;
    margin-top: var(--space-6);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
  }

  .prose {
    margin-top: var(--space-6);
  }

  /* Foot — prev/next pager + permalink */
  .page-foot {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  .pager-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    transition:
      border-color 0.15s ease,
      background 0.15s ease;
  }

  a.pager-link:hover {
    border-color: var(--color-brand);
    background: var(--color-surface-tinted);
  }

  .pager-link.next {
    text-align: right;
  }

  .pager-link.is-empty {
    border: none;
    background: none;
  }

  .pager-dir {
    font-size: 0.76rem;
    color: var(--color-text-muted);
  }

  a.pager-link:hover .pager-dir {
    color: var(--color-brand);
  }

  .pager-title {
    font-size: 0.9rem;
    line-height: 1.35;
    color: var(--color-text-secondary);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
    overflow: hidden;
  }

  .page-foot .permalink {
    display: inline-block;
    margin-top: var(--space-4);
    font-size: 0.82rem;
    color: var(--color-text-muted);
    transition: color 0.15s ease;
  }

  .page-foot .permalink:hover {
    color: var(--color-brand);
  }

  @media (max-width: 820px) {
    .page {
      max-width: none;
    }

    .pager {
      grid-template-columns: 1fr;
    }

    .pager-link.is-empty {
      display: none;
    }
  }
</style>
