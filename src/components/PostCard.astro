---
import { formatPublishedDate, toIsoDate } from "../lib/dates";
import type { Post } from "../lib/posts";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, summary, publishedAt, authors, featured } = post.data;
const href = `/posts/${post.id}`;
---

<article class:list={["card", { featured }]}>
  <time datetime={toIsoDate(publishedAt)}>{formatPublishedDate(publishedAt)}</time>
  <h3>
    <a href={href}>{title}</a>
  </h3>
  <p class="summary">{summary}</p>
  <p class="meta">{authors.join("、")}</p>
</article>

<style>
  .card {
    padding: 1.2rem 1.4rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease,
      border-color 0.15s ease;
  }

  .card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-border-strong);
  }

  .card.featured {
    border-color: color-mix(in srgb, var(--color-brand) 35%, transparent);
    background: linear-gradient(180deg, var(--color-brand-tint) 0%, var(--color-surface) 60%);
  }

  time {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
  }

  h3 {
    margin: 0.35rem 0 0.5rem;
    font-size: 1.2rem;
  }

  h3 a {
    color: var(--color-text);
    transition: color 0.15s ease;
  }

  h3 a:hover {
    color: var(--color-brand);
  }

  .summary {
    margin: 0;
    color: var(--color-text-secondary);
  }

  .meta {
    margin: 0.7rem 0 0;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }
</style>
