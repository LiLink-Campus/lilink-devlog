---
import { Image } from "astro:assets";
import { formatPublishedDate, formatWeekLabel, toIsoDate } from "../lib/dates";
import type { Post } from "../lib/posts";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, summary, publishedAt, authors, cover } = post.data;

const ogImage = `/og/${post.id}.png`;
const url = new URL(`/posts/${post.id}`, Astro.site).href;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description: summary,
  datePublished: toIsoDate(publishedAt),
  inLanguage: "zh-CN",
  author: authors.map((name) => ({ "@type": "Organization", name })),
  image: new URL(ogImage, Astro.site).href,
  url,
  mainEntityOfPage: url,
  publisher: {
    "@type": "Organization",
    name: "LiLink",
    logo: {
      "@type": "ImageObject",
      url: new URL("/og-default.png", Astro.site).href,
    },
  },
};
---

<BaseLayout
  title={title}
  description={summary}
  ogType="article"
  publishedTime={toIsoDate(publishedAt)}
  ogImage={ogImage}
  jsonLd={jsonLd}
>
  <article class="post">
    <a class="back" href="/">← 全部更新</a>
    <header class="post-header">
      <p class="post-meta">
        <time datetime={toIsoDate(publishedAt)}>{formatPublishedDate(publishedAt)}</time>
        <span class="dot" aria-hidden="true">·</span>
        <span class="week">{formatWeekLabel(publishedAt)}</span>
        <span class="dot" aria-hidden="true">·</span>
        <span class="by">{authors.join("、")}</span>
      </p>
      <h1>{title}</h1>
      <p class="summary">{summary}</p>
    </header>
    {cover ? <Image class="cover" src={cover} alt={title} widths={[480, 960]} /> : null}
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  /* Same reading measure as the home book, so an entry reads identically
     whether inline or on its own page. */
  .post {
    width: min(100% - 2.4rem, var(--measure));
    margin-inline: auto;
    padding-block: var(--space-6) var(--space-4);
  }

  .back {
    display: inline-block;
    margin-bottom: var(--space-5);
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    transition: color 0.15s ease;
  }

  .back:hover {
    color: var(--color-brand);
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
    margin: 0;
    font-size: 0.82rem;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .post-meta .dot {
    color: var(--color-border-strong);
  }

  .post-header h1 {
    margin: var(--space-3) 0 var(--space-4);
    font-size: clamp(1.75rem, 3.5vw, 2.25rem);
    text-wrap: balance;
  }

  .post-header .summary {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  .cover {
    width: 100%;
    height: auto;
    margin-top: var(--space-6);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
  }

  /* Long-form typography lives in styles/prose.css (shared with the home book). */
  .prose {
    margin-top: var(--space-6);
  }
</style>
