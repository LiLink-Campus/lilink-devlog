---
import { Image } from "astro:assets";
import { formatPublishedDate, toIsoDate } from "../lib/dates";
import type { Post } from "../lib/posts";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, summary, publishedAt, authors, cover } = post.data;
---

<BaseLayout
  title={title}
  description={summary}
  ogType="article"
  publishedTime={toIsoDate(publishedAt)}
>
  <article class="container-prose post">
    <a class="back" href="/">← 全部更新</a>
    <header class="post-header">
      <time datetime={toIsoDate(publishedAt)}>{formatPublishedDate(publishedAt)}</time>
      <h1>{title}</h1>
      <p class="summary">{summary}</p>
      <p class="authors">{authors.join("、")}</p>
    </header>
    {cover ? <Image class="cover" src={cover} alt={title} widths={[480, 960]} /> : null}
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    padding-block: 2.5rem 1rem;
  }

  .back {
    display: inline-block;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
    color: var(--color-text-secondary);
  }

  .back:hover {
    color: var(--color-brand);
  }

  .post-header time {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .post-header h1 {
    margin: 0.4rem 0 0.6rem;
    font-size: clamp(1.8rem, 4vw, 2.4rem);
  }

  .post-header .summary {
    margin: 0;
    font-size: 1.05rem;
    color: var(--color-text-secondary);
  }

  .post-header .authors {
    margin: 0.8rem 0 0;
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }

  .cover {
    width: 100%;
    height: auto;
    margin-top: 1.6rem;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
  }

  .prose {
    margin-top: 2rem;
    font-size: 1.02rem;
    line-height: 1.8;
  }

  .prose :global(h2) {
    margin: 2.2rem 0 0.8rem;
    font-size: 1.4rem;
  }

  .prose :global(h3) {
    margin: 1.8rem 0 0.6rem;
    font-size: 1.15rem;
  }

  .prose :global(p) {
    margin: 0 0 1.1rem;
  }

  .prose :global(a) {
    color: var(--color-brand);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.1rem;
  }

  .prose :global(li) {
    margin-bottom: 0.4rem;
  }

  .prose :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    margin: 1.4rem 0;
  }

  .prose :global(blockquote) {
    margin: 1.4rem 0;
    padding: 0.6rem 1.2rem;
    border-left: 3px solid var(--color-brand);
    background: var(--color-brand-tint);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    color: var(--color-brand-ink);
  }

  .prose :global(code) {
    font-size: 0.92em;
    background: var(--color-surface-muted);
    padding: 0.1rem 0.35rem;
    border-radius: var(--radius-xs);
  }

  .prose :global(pre) {
    padding: 1rem 1.2rem;
    border-radius: var(--radius-md);
    overflow-x: auto;
    font-size: 0.9rem;
  }

  .prose :global(pre code) {
    background: none;
    padding: 0;
  }

  .prose :global(hr) {
    margin: 2rem 0;
    border: none;
    border-top: 1px solid var(--color-border);
  }
</style>
